rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is authenticated
    function isAuthed() {
      return request.auth != null;
    }

    // Helper: admin/staff role via custom claim `staff: true`
    function isAdmin() {
      return isAuthed() && request.auth.token.staff == true;
    }

    // Helper: the single owner of the private Teaching HQ area.
    function isTeachingOwner() {
      // Prefer a server-set custom claim; fall back to the owner email but only
      // when it is verified (an unverified same-email account cannot pass).
      return isAuthed() && (
        request.auth.token.teachingOwner == true ||
        (request.auth.token.email == 'jtaft@pusdk12.org' && request.auth.token.email_verified == true)
      );
    }

    // timeclock (raw events) - admin only
    match /timeclock/{docId} {
      allow read, write: if isAdmin();
    }

    // sessions: admin sees all; users see only their own (studentId == auth uid)
    match /sessions/{docId} {
      allow read: if isAdmin() || (isAuthed() && resource.data.studentId == request.auth.uid);
      allow write: if isAdmin();
    }

    // warnings: admin sees all; users see only their own
    match /warnings/{docId} {
      allow read: if isAdmin() || (isAuthed() && resource.data.studentId == request.auth.uid);
      allow write: if isAdmin();
    }

    // Rewards catalog - readable by all authenticated users
    match /rewards/{docId} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    match /purchases/{docId} {
      allow read: if isAuthed();
      allow create, update, delete: if isAdmin();
    }

    // Reward purchases: admin sees all; users see only their own
    match /reward_purchases/{docId} {
      allow read: if isAdmin() || (isAuthed() && resource.data.studentId == request.auth.uid);
      allow write: if isAdmin();
    }

    // Pay periods - admin only (contains configuration/rates)
    match /pay_periods/{docId} {
      allow read, write: if isAdmin();
    }

    // Payroll: admin sees all; users see only their own record
    match /payroll/{docId} {
      allow read: if isAdmin() || (isAuthed() && resource.data.studentId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /bank/{docId} {
      allow read, write: if isAdmin();
    }

    // Students: admin sees all; users see only their own doc (doc id == auth uid)
    match /students/{studentId} {
      allow read: if isAdmin() || (isAuthed() && request.auth.uid == studentId);
      allow write: if isAdmin();
    }

    // Classes: readable by any authenticated user (students need their class
    // name and meeting times); only admins can create/edit/archive.
    match /classes/{classId} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    // Scenario attempts: admin sees all; users see/manage only their own (studentId == uid)
    match /attempts/{docId} {
      allow read: if isAdmin() || (isAuthed() && resource.data.studentId == request.auth.uid);
      allow create: if isAdmin() || (isAuthed() && request.resource.data.studentId == request.auth.uid);
      allow update, delete: if isAdmin() || (isAuthed() && resource.data.studentId == request.auth.uid);
    }

    // Scenario catalog: readable by all authenticated users; admin-managed
    match /scenarios/{docId} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    // Per-student progress: admin sees all; users see/manage only their own (studentId == uid)
    match /progress/{docId} {
      allow read: if isAdmin() || (isAuthed() && resource.data.studentId == request.auth.uid);
      allow create: if isAdmin() || (isAuthed() && request.resource.data.studentId == request.auth.uid);
      allow update, delete: if isAdmin() || (isAuthed() && resource.data.studentId == request.auth.uid);
    }

    // School/org config: readable by all authenticated users; admin-managed
    match /schools/{docId} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    // Licensing / feature flags: readable by all authenticated users; admin-managed
    match /license/{docId} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    // User records: admin sees all; users see only their own (authUID == uid); admin-managed writes
    match /users/{docId} {
      allow read: if isAdmin() || (isAuthed() && resource.data.authUID == request.auth.uid);
      allow write: if isAdmin();
    }

    // Teaching HQ: private teacher workspace. Only the owner may read or write,
    // enforced here regardless of anything the client UI does.
    match /teaching/{docId} {
      allow read, write: if isTeachingOwner();
    }

    // Classroom Status Board state (per-period boards), synced across devices.
    // Owner-only, same as Teaching HQ.
    match /statusBoard/{docId} {
      allow read, write: if isTeachingOwner();
    }

    // Hall passes: teachers read the log; all writes go through Cloud Functions
    // (admin SDK), so the immutable audit trail can't be tampered with client-side.
    match /passes/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Hall pass semester payout summaries — written by the rollover function.
    match /hallPassPayouts/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // App settings (e.g. settings/hallPass): readable by authed users, admin-managed.
    match /settings/{docId} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
